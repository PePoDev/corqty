POSTGRES_DB=corqty
# Local defaults only. scripts/init-local creates fresh credentials and a master key.
POSTGRES_SUPERUSER_PASSWORD=postgres_dev
CORQTY_OWNER_DB_PASSWORD=corqty_owner_dev
CORQTY_API_DB_PASSWORD=corqty_api_dev
CORQTY_WORKER_DB_PASSWORD=corqty_worker_dev
CORQTY_POSTGRES_PORT=5432
CORQTY_API_PORT=8080
CORQTY_WEB_PORT=3000
DATABASE_URL_OWNER=postgres://corqty_owner:corqty_owner_dev@postgres:5432/corqty
DATABASE_URL_API=postgres://corqty_api:corqty_api_dev@postgres:5432/corqty
DATABASE_URL_WORKER=postgres://corqty_worker:corqty_worker_dev@postgres:5432/corqty
# Node runs that each worker container executes at once.
CORQTY_WORKER_CAPACITY=4
# "enabled" lets organization admins turn on the trusted shell executor (api and worker).
# Shell commands run as the shared worker user and can reach the worker's database
# credential and other organizations' jobs: enable it only on single-tenant or fully
# trusted deployments.
CORQTY_SHELL_EXECUTOR=disabled
# REQUIRED: base64 of 32 cryptographically random bytes, shared by API and workers.
# Generate with `openssl rand -base64 32` or scripts/init-local.ps1; keep a secure backup.
# Losing this key makes stored secrets and webhook signing secrets unrecoverable.
CORQTY_MASTER_KEY=
# Bounded deployment limits; these may be reduced, never raised above these ceilings.
CORQTY_MAX_NODES=500
CORQTY_MAX_EDGES=1000
CORQTY_MAX_RUN_INPUT_BYTES=1048576
CORQTY_MAX_NODE_INPUT_BYTES=1048576
CORQTY_MAX_NODE_OUTPUT_BYTES=1048576
CORQTY_MAX_LOG_BYTES=10485760
CORQTY_MAX_WEBHOOK_BYTES=1048576
CORQTY_MAX_COMPONENT_BYTES=26214400
CORQTY_MAX_WASM_MEMORY_BYTES=268435456
CORQTY_DEFAULT_TIMEOUT_SECONDS=900
CORQTY_MAX_TIMEOUT_SECONDS=14400
CORQTY_AUTH_RATE_PER_MINUTE=30
CORQTY_TOKEN_RATE_PER_MINUTE=120
CORQTY_WEBHOOK_RATE_PER_MINUTE=120
CORQTY_BIND_ADDRESS=0.0.0.0:8080
CORQTY_PUBLIC_WEB_URL=http://localhost:3000
CORQTY_SECURE_COOKIES=false
CORQTY_API_ORIGIN=http://api:8080
RUST_LOG=corqty_api=info,tower_http=info
